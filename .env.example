# 이름만 담는 견본. 실제 값은 .env(로컬)·Vercel env(배포)에 두고 커밋하지 않는다.
# 값의 정본은 금고, 위치는 vault security/credentials-map.md.

# 검색 DB. 개발 = radsafety-lawbot-dev / 운영 반영 뒤 = RadSafety 운영 DB.
SUPABASE_URL=
# Secret key(sb_secret_…). RLS 를 건너뛴다 — 서버에서만 쓰고 브라우저로 내보내지 않는다.
SUPABASE_SECRET_KEY=

# 질의 임베딩 + 답변 생성. AI Studio 프로젝트 radsafety (월 지출 상한 공유).
GEMINI_API_KEY=

# 1차 비공개 운영용 접근 코드. 로그인 연결(2차) 전까지 이 코드를 아는 사람만 쓴다.
LAWBOT_ACCESS_CODE=
