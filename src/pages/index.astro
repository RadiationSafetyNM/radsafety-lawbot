---
import Base from '../layouts/Base.astro';
import { todayKST } from '../lib/ask';
const today = todayKST();
---
<Base>
    <h1>방사선안전 법령 질의</h1>
    <p class="sub">
        오늘 시행 중인 법령으로 답합니다. 바뀔 예정인 조문은 날짜와 함께 알려 드립니다.
        답변은 참고용이며 법적 효력이 없습니다.
    </p>

    <form id="f" class="card">
        <textarea id="q" maxlength="500" placeholder="예) 방사선안전관리자는 어떻게 선임하고 신고해야 합니까?" required></textarea>
        <div class="row">
            <label class="asof">기준일 <input type="date" id="asof" value={today} data-today={today} /></label>
            <button id="go" type="submit">질문하기</button>
        </div>
    </form>

    <section id="out" hidden>
        <p id="asofnote" class="sub"></p>
        <div class="card"><div id="answer"></div>
            <div id="fb">
                <button type="button" id="fbopen" class="ghost">이 답변이 이상해요</button>
                <div id="fbform" hidden>
                    <textarea id="fbnote" maxlength="1000" placeholder="무엇이 이상한지 한 줄로 적어 주십시오(선택). 예) 근거 조문이 틀림, 숫자가 다름"></textarea>
                    <p class="small">질문·답변·근거 조문 제목이 개선용으로 기록됩니다. 개인정보는 적지 마십시오.</p>
                    <button type="button" id="fbsend">보내기</button>
                </div>
                <p id="fbdone" class="small" hidden></p>
            </div>
        </div>
        <div id="pending"></div>
        <h2>근거 조문 <span class="sub">(기준일에 시행 중)</span></h2>
        <div id="sources"></div>
        <div id="upwrap" hidden>
            <h2>시행예정 판본</h2>
            <div id="upcoming"></div>
        </div>
    </section>
    <p id="err" class="err" hidden></p>
</Base>

<style>
.row { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 12px; flex-wrap: wrap; }
.asof { color: var(--sub); font-size: .9rem; display: flex; align-items: center; gap: 8px; }
.asof input { width: auto; padding: 6px 8px; }
#out { margin-top: 20px; }
#fb { border-top: 1px solid var(--line); margin-top: 12px; padding-top: 10px; }
#fb .ghost { background: transparent; color: var(--sub); border: 1px solid var(--line); font-size: .85rem; padding: 4px 10px; }
#fb textarea { min-height: 60px; margin-top: 8px; }
#fb .small { color: var(--sub); font-size: .82rem; margin: 6px 0; }
h2 { font-size: 1rem; margin: 24px 0 8px; }
h2 .sub { font-weight: 400; }
#answer :global(p) { margin: 0 0 .8em; white-space: pre-wrap; }
#answer :global(.note) { background: var(--note-bg); border-left: 4px solid var(--note-line); color: var(--note-ink);
    padding: 10px 12px; border-radius: 6px; }
#answer :global(.basis) { color: var(--sub); font-size: .92rem; border-top: 1px solid var(--line);
    padding-top: 10px; margin-bottom: 0; }
:global(.pend) { margin-top: 12px; border: 1px dashed var(--line); border-radius: 12px; padding: 12px 14px;
    background: var(--card); }
:global(.pend .tag) { display: inline-block; font-size: .78rem; font-weight: 700; color: var(--sub);
    border: 1px solid var(--line); border-radius: 999px; padding: 1px 8px; margin-bottom: 6px; }
:global(.pend p) { margin: 4px 0; }
:global(.pend .small) { color: var(--sub); font-size: .85rem; }
:global(.pend a) { color: var(--accent); }
:global(details.src) { background: var(--card); border: 1px solid var(--line); border-radius: 10px;
    padding: 10px 14px; margin-bottom: 8px; }
:global(details.src summary) { cursor: pointer; font-weight: 600; }
:global(details.src .meta) { font-weight: 400; color: var(--sub); font-size: .85rem; margin-left: 6px; }
:global(details.src .chg) { color: var(--note-ink); background: var(--note-bg); border-radius: 4px; padding: 1px 6px; }
:global(details.src pre) { white-space: pre-wrap; word-break: break-word; font: inherit; font-size: .9rem;
    margin: 10px 0 2px; max-height: 420px; overflow: auto; }
</style>

<script>
type Src = { title: string; effectiveFrom: string; effectiveTo: string | null; content: string };
type Pend = { title: string; law: string; current: string; proposed: string; status: string;
    expected_effective: string; confidence: string; timeline: { date: string; event: string }[]; sources: string[] };
function pendCard(p: Pend) {
    const tl = p.timeline.map((t) => `${esc(t.date)} ${esc(t.event)}`).join(' · ');
    const src = p.sources.map((u, i) => `<a href="${esc(u)}" target="_blank" rel="noopener">출처${p.sources.length > 1 ? i + 1 : ''}</a>`).join(' ');
    return `<div class="pend"><span class="tag">입법 진행 중 — 확정 아님</span>
        <p><strong>${esc(p.title)}</strong> (${esc(p.law)})</p>
        <p>현행 ${esc(p.current)} → 개정안 ${esc(p.proposed)}</p>
        <p class="small">${esc(p.status)}${p.expected_effective ? ` · 시행 목표 ${kdate(p.expected_effective)}` : ''} · ${esc(p.confidence)}</p>
        <p class="small">${tl} ${src}</p>
        <p class="small">위 답변은 현행 법령 기준입니다. 이 내용은 공포 전이라 답변에 반영하지 않았습니다.</p></div>`;
}
const $ = (id: string) => document.getElementById(id)!;
let last: { question: string; answer: string; sources: Src[]; asOf: string } | null = null;
function resetFb() {
    $('fbopen').hidden = false; $('fbform').hidden = true; $('fbdone').hidden = true;
    ($('fbnote') as HTMLTextAreaElement).value = '';
}
$('fbopen').addEventListener('click', () => { $('fbopen').hidden = true; $('fbform').hidden = false; });
$('fbsend').addEventListener('click', async () => {
    if (!last) return;
    const btn = $('fbsend') as HTMLButtonElement;
    btn.disabled = true;
    try {
        const r = await fetch('/api/feedback', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...last, sources: last.sources.map((s) => ({ title: s.title, effectiveFrom: s.effectiveFrom })),
                note: ($('fbnote') as HTMLTextAreaElement).value }),
        });
        const d = await r.json().catch(() => ({}));
        $('fbdone').textContent = r.ok ? '기록했습니다. 고맙습니다.' : (d.error ?? '기록하지 못했습니다.');
        if (r.ok) $('fbform').hidden = true;
        $('fbdone').hidden = false;
    } finally { btn.disabled = false; }
});
const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
const kdate = (d: string) => { const [y, m, dd] = d.split('-'); return `${y}년 ${+m}월 ${+dd}일`; };

function renderAnswer(text: string) {
    return text.split(/\n{2,}|\n(?=※|「근거」)/).map((para) => {
        const t = para.trim();
        if (!t) return '';
        const html = esc(t).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        const cls = t.startsWith('※') ? ' class="note"' : t.startsWith('「근거」') ? ' class="basis"' : '';
        return `<p${cls}>${html}</p>`;
    }).join('');
}
function card(s: Src, upcoming: boolean) {
    const meta = upcoming
        ? `<span class="chg">${kdate(s.effectiveFrom)}부터 시행</span>`
        : s.effectiveTo ? `<span class="chg">${kdate(s.effectiveTo)}부터 바뀜</span>` : '';
    return `<details class="src"><summary>${esc(s.title)} <span class="meta">${meta}</span></summary><pre>${esc(s.content)}</pre></details>`;
}

$('f').addEventListener('submit', async (e) => {
    e.preventDefault();
    const go = $('go') as HTMLButtonElement, asof = $('asof') as HTMLInputElement;
    const question = ($('q') as HTMLTextAreaElement).value.trim();
    if (!question) return;
    go.disabled = true; go.textContent = '찾는 중…';
    $('err').hidden = true;
    try {
        const r = await fetch('/api/ask', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question, asOf: asof.value || undefined }),
        });
        if (r.status === 401) { location.href = '/enter'; return; }
        const d = await r.json();
        if (!r.ok) throw new Error(d.error ?? '오류가 발생했습니다');
        $('asofnote').textContent = d.asOf === asof.dataset.today ? '' : `기준일 ${kdate(d.asOf)} 로 답한 결과입니다.`;
        $('answer').innerHTML = renderAnswer(d.answer);
        last = { question, answer: d.answer, sources: d.sources, asOf: d.asOf };
        resetFb();
        $('pending').innerHTML = (d.pending ?? []).map(pendCard).join('');
        $('sources').innerHTML = d.sources.map((s: Src) => card(s, false)).join('');
        $('upcoming').innerHTML = d.upcoming.map((s: Src) => card(s, true)).join('');
        $('upwrap').hidden = d.upcoming.length === 0;
        $('out').hidden = false;
    } catch (ex) {
        $('err').textContent = (ex as Error).message; $('err').hidden = false;
    } finally {
        go.disabled = false; go.textContent = '질문하기';
    }
});
</script>
