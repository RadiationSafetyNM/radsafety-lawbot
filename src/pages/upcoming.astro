---
import Base from '../layouts/Base.astro';
import { upcoming, type Entry, type Seg } from '../lib/upcoming';
import { prenotice, type Notice } from '../lib/prenotice';

let data: Awaited<ReturnType<typeof upcoming>> | null = null, error = '';
try { data = await upcoming(); } catch (e) { error = (e as Error).message; }
const pre: { main: Notice[]; other: Notice[] } = data ? await prenotice(data.today) : { main: [], other: [] };
const md = (d: string) => { const [, m, dd] = d.split('-'); return `${+m}.${+dd}.`; };
/** 법령안·이유서 파일만(같은 문서의 hwpx·pdf 가 함께 오면 pdf 를 먼저). */
const files = (n: Notice) => [...n.files].sort((a, b) => Number(b.name.endsWith('.pdf')) - Number(a.name.endsWith('.pdf'))).slice(0, 4);

const kdate = (d: string) => { const [y, m, dd] = d.split('-'); return `${y}년 ${+m}월 ${+dd}일`; };
const dday = (d: string, today: string) => Math.round((Date.parse(d) - Date.parse(today)) / 86400000);
const byDate = (es: Entry[]) => {
    const m = new Map<string, Entry[]>();
    for (const e of es) m.set(e.date, [...(m.get(e.date) ?? []), e]);
    return [...m];
};
const byLaw = <T extends { law: string }>(hs: T[]) => {
    const m = new Map<string, T[]>();
    for (const h of hs) m.set(h.law, [...(m.get(h.law) ?? []), h]);
    return [...m];
};
/** 같은 줄이 길게 이어지면 앞뒤 한 줄씩만 남기고 접는다. */
const fold = (d: Seg[]) => d.filter((s, i) => s.t !== 'same' || d[i - 1]?.t !== 'same' || d[i + 1]?.t !== 'same');
/** 짝지어진 줄은 달라진 낱말만, 통째로 새로 생기거나 없어지는 줄은 표시 없이 색 띠만. */
const parts = (s: Seg) => s.parts ?? [{ s: s.text, c: false }];
---
<Base title="개정 예정 — 의료 방사선안전">
    <nav class="top"><a href="/">질문하기</a><strong>개정 예정</strong></nav>
    <h1>개정 예정 — 의료 방사선안전</h1>
    <p class="sub">
        공포되어 시행을 기다리는 조문 가운데 의료기관의 방사선안전과 관련된 것만 골랐습니다.
        붉은 줄은 지금 조문, 푸른 줄은 바뀌는 조문입니다. 참고용이며 법적 효력이 없습니다.
    </p>
    {error && <p class="err">불러오지 못했습니다 — {error}</p>}
    {data && <>
        {!data.confirmed && <p class="chk">주제 분류는 검토 중입니다.</p>}
        {data.medical.length === 0 && <p class="card">지금은 시행을 기다리는 의료 방사선안전 조문이 없습니다.</p>}
        {byDate(data.medical).map(([date, es]) => <section>
            <h2>{kdate(date)}부터 <span class="sub">({dday(date, data!.today)}일 뒤 · {es.length}건)</span></h2>
            {es.map((e) => <details class="up">
                <summary>{e.title} <span class={`tag ${e.kind === '개정' ? '' : 'hl'}`}>{e.kind}</span>{e.cls === 'new' && <span class="tag hl">분류 전</span>}
                    {e.note && <p class="note">{e.note}</p>}</summary>
                <div class="diff">{fold(e.diff).map((s) => <p class={s.t}>{parts(s).map((x) => x.c ? <mark>{x.s}</mark> : x.s)}</p>)}</div>
            </details>)}
        </section>)}

        {data.pending.length > 0 && <section>
            <h2>입법 진행 중 <span class="sub">(공포 전 — 확정 아님)</span></h2>
            {data.pending.map((p) => <div class="card pend">
                <p><strong>{p.title}</strong> ({p.law})</p>
                <p>현행 {p.current} → 개정안 {p.proposed}</p>
                <p class="small">{p.status}{p.expected_effective && ` · 시행 목표 ${kdate(p.expected_effective)}`} · {p.confidence}</p>
                <p class="small">{p.timeline.map((t) => `${t.date} ${t.event}`).join(' · ')}
                    {p.sources.map((u, i) => <> <a href={u} target="_blank" rel="noopener">출처{p.sources.length > 1 ? i + 1 : ''}</a></>)}</p>
            </div>)}
        </section>}

        {pre.main.length > 0 && <section>
            <h2>입법예고·행정예고 <span class="sub">(공포 전 — 확정 아님 · 국민참여입법센터 자동 수집, 주제 분류는 낱말 규칙)</span></h2>
            {pre.main.map((n) => <details class="up pre">
                <summary>{n.title}
                    <span class="tag">{n.kind}</span>
                    {n.open ? <span class="tag hl">의견수렴 중 ~{md(n.end)}</span> : <span class="tag">예고 {md(n.start)}~{md(n.end)} 종료</span>}
                    {n.stage && n.stage !== n.kind && <span class="tag">{n.stage} {md(n.stage_date)}</span>}
                    <p class="note small">{n.agency}{n.dept && ` ${n.dept}`} · 공고 {n.notice_no}</p></summary>
                <div class="diff">
                    {n.summary && <p class="same">{n.summary}</p>}
                    <p><a href={n.link} target="_blank" rel="noopener">예고 원문</a>
                        {files(n).map((f) => <> · <a href={f.url} target="_blank" rel="noopener">{f.name.replace(/^\(([^)]*)\).*(\.[a-z]+)$/, '$1$2')}</a></>)}</p>
                </div>
            </details>)}
        </section>}
        {pre.other.length > 0 && <details class="more">
            <summary>그 밖의 예고 {pre.other.length}건 <span class="sub">(원자로·핵연료·방재 등 — 의료기관 범위 밖으로 분류된 것)</span></summary>
            <div class="hid"><ul>{pre.other.map((n) => <li><a href={n.link} target="_blank" rel="noopener">{n.title}</a>
                <span class="sub"> · {n.agency} · {n.kind} {md(n.start)}~{md(n.end)}{n.open && ' (의견수렴 중)'}</span></li>)}</ul></div>
        </details>}

        {data.other.length > 0 && <details class="more">
            <summary>그 밖의 방사선 관련 개정 {data.other.length}건 <span class="sub">(주제가 의료기관 범위 밖이거나 문구만 바뀌는 것)</span></summary>
            {data.other.map((e) => <details class="up">
                <summary>{e.title} <span class="tag">{kdate(e.date)}</span> <span class="tag">{e.kind}</span>{e.topics.map((t) => <span class="tag">{t}</span>)}
                    {e.note && <p class="note">{e.note}</p>}</summary>
                <div class="diff">{fold(e.diff).map((s) => <p class={s.t}>{parts(s).map((x) => x.c ? <mark>{x.s}</mark> : x.s)}</p>)}</div>
            </details>)}
        </details>}
        {data.hidden.length > 0 && <details class="more">
            <summary>표시하지 않은 시행예정 조문 {data.hidden.length}건 <span class="sub">(제목만 — 빠뜨린 것이 없는지 확인용)</span></summary>
            {byLaw(data.hidden).map(([law, hs]) => <div class="hid"><p><strong>{law}</strong> <span class="sub">{hs.length}건</span></p>
                <ul>{hs.map((h) => <li>{h.title} <span class="sub">· {kdate(h.date)}{h.why !== '방사선 낱말 없음' && ` · ${h.why}`}</span></li>)}</ul></div>)}
        </details>}
        <p class="sub foot">기준일 {kdate(data.today)}.</p>
    </>}
</Base>

<style>
.top { display: flex; gap: 14px; font-size: .9rem; margin-bottom: 14px; }
.top a { color: var(--accent); }
h2 { font-size: 1rem; margin: 26px 0 8px; }
h2 .sub, summary .sub { font-weight: 400; font-size: .85rem; }
.chk { border-radius: 10px; padding: 8px 12px; font-size: .88rem; background: var(--note-bg);
    border-left: 4px solid var(--note-line); color: var(--note-ink); }
details.up { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; margin-bottom: 8px; }
details.up summary { cursor: pointer; font-weight: 600; }
.tag { display: inline-block; font-size: .75rem; font-weight: 600; color: var(--sub); border: 1px solid var(--line);
    border-radius: 999px; padding: 0 8px; margin-left: 4px; }
.tag.hl { color: var(--note-ink); background: var(--note-bg); border-color: var(--note-line); }
.note { font-weight: 400; font-size: .92rem; margin: 6px 0 0; }
.diff { margin-top: 10px; border-top: 1px solid var(--line); padding-top: 8px; font-size: .88rem; }
.diff p { margin: 0 0 4px; padding: 2px 8px; white-space: pre-wrap; word-break: break-word; border-left: 3px solid transparent; }
.diff .same { color: var(--sub); }
.diff .del { border-left-color: #c0392b; background: color-mix(in srgb, #c0392b 9%, transparent); }
.diff .add { border-left-color: #1f6fb5; background: color-mix(in srgb, #1f6fb5 10%, transparent); }
.diff mark { background: transparent; color: inherit; }
.diff .del mark { text-decoration: line-through; background: color-mix(in srgb, #c0392b 22%, transparent); }
.diff .add mark { font-weight: 700; background: color-mix(in srgb, #1f6fb5 24%, transparent); }
.pend { border-style: dashed; margin-bottom: 8px; }
details.pre { border-style: dashed; }
details.pre a, .hid a { color: var(--accent); }
details.pre .diff .same { color: inherit; }
.pend p { margin: 4px 0; }
.small { color: var(--sub); font-size: .85rem; }
.pend a { color: var(--accent); }
details.more { margin-top: 28px; }
details.more > summary { cursor: pointer; font-weight: 600; margin-bottom: 10px; }
.hid p { margin: 12px 0 4px; }
.hid ul { margin: 0; padding-left: 20px; font-size: .88rem; }
.hid .sub { font-size: .8rem; }
.foot { margin-top: 24px; font-size: .82rem; }
</style>
